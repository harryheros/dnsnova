[Unit]
Description=dnsnova DNS server
Documentation=https://github.com/harryheros/dnsnova
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnsnova
Group=dnsnova
ExecStartPre=/usr/local/bin/dnsnova -t -c /etc/dnsnova/dnsnova.toml
ExecStart=/usr/local/bin/dnsnova -c /etc/dnsnova/dnsnova.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2

# Only the right to bind ports below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandbox: read-only system, writable configuration and data directories.
ProtectSystem=strict
ReadWritePaths=/etc/dnsnova /var/lib/dnsnova
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK lets the setup wizard list the network interfaces.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
